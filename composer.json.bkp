{
    "name": "hal/yii2-mongodb-filemodels",
    "description": "Module for model attachments on mongodb GridFS",
    "type": "yii2-extension",
    "keywords": ["yii2","filemodels","attachments","files","mongodb"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Curatitoli",
            "email": "marco.curatitoli@halservice.it"
        }
    ],
    "require": {
        "yiisoft/yii2": "*",
        "yiisoft/yii2-bootstrap": "*",
        "hal/yii2-fontawesome": "*",
        "yii2tech/embedded" : "*"
    },
    "autoload": {
        "psr-4": {
            "hal\\mongodb\\filemodels\\": ""
        }
    },
    "extra": {
        "bootstrap": "hal\\mongodb\\filemodels\\Bootstrap"
    }
}
